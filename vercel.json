{
  "installCommand": "npm --prefix societyselect ci",
  "buildCommand": "npm --prefix societyselect run build",
  "outputDirectory": "societyselect/dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://societyselect.onrender.com/api/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
